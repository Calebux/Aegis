# Celo RPC — Celo mainnet public endpoint (read-only, no key needed)
CELO_RPC_URL=https://forno.celo.org

# Optional: webhook secret for authenticated POST calls
WEBHOOK_SECRET=

# Optional: port for the Express server (default: 4000)
PORT=4000

# Optional: alert webhook URL (Slack, Discord, etc.)
ALERT_WEBHOOK_URL=

# Optional: Celo private key for on-chain attestation (hex, 0x-prefixed)
# Only needed if you want to write receipts on-chain
CELO_PRIVATE_KEY=
