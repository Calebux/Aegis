# ─────────────────────────────────────────────
# REQUIRED — pipeline will not start without these
# ─────────────────────────────────────────────

# Anthropic — used by task decomposer and Scribe agent
# Get yours at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Linkup — used by Scout agent for web search
# Get yours at: https://app.linkup.so
LINKUP_API_KEY=

# Stellar admin keypair — used to register agents on Shield + Identity Registry
# This is the SECRET key of the account that deployed the contracts.
# Generate a new one with: stellar keys generate admin --network testnet
ORCHESTRATOR_SECRET_KEY=

# ─────────────────────────────────────────────
# SOROBAN CONTRACTS — pre-deployed on Stellar testnet (leave as-is)
# ─────────────────────────────────────────────
SHIELD_CONTRACT_ID=CDD4J3B3Y44SDUKZQYEU2XPS4KBGAMLUQEWVSR2I25GXFGAQ6KD453N5
REGISTRY_CONTRACT_ID=CD5SGG7E6GIZPCGSOAKLCKRF5RRNZ3462MX4RQDT3NE6BD74GVAOMHET

# ─────────────────────────────────────────────
# STELLAR NETWORK — defaults are fine for testnet
# ─────────────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# ─────────────────────────────────────────────
# HORIZON x402 SERVER — Aegis as an x402 provider (optional)
# Leave HORIZON_PAYMENT_RECEIVER blank to run in dev mode (no payments required)
# Set it to a real Stellar address to enable paid queries
# ─────────────────────────────────────────────
HORIZON_PAYMENT_RECEIVER=
HORIZON_PAYMENT_AMOUNT=0.01
HORIZON_X402_SERVER_URL=http://localhost:3001

# ─────────────────────────────────────────────
# AUTO-MANAGED — set automatically at runtime, do not edit
# ─────────────────────────────────────────────

# Agent wallets — provisioned fresh by the orchestrator on each run
SCOUT_SECRET_KEY=
LEDGER_SECRET_KEY=
SIGNAL_SECRET_KEY=
SCRIBE_SECRET_KEY=

# Cross-agent awareness: set by orchestrator to Scout's public key
SCOUT_WALLET_ADDRESS=

# ─────────────────────────────────────────────
# DASHBOARD (Next.js)
# ─────────────────────────────────────────────
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
