ANTHROPIC_API_KEY=
SHIELD_CONTRACT_ID=
REGISTRY_CONTRACT_ID=
HORIZON_WALLET_ADDRESS=
STELLAR_NETWORK=testnet
LINKUP_API_KEY=

# Extended config
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Sub-agent wallets (auto-generated on first run if left empty)
SCOUT_SECRET_KEY=
LEDGER_SECRET_KEY=
SIGNAL_SECRET_KEY=
SCRIBE_SECRET_KEY=

# x402 facilitator
X402_FACILITATOR_URL=https://facilitator.coinbase.com

# Horizon x402 server (Aegis as x402 provider)
# HORIZON_PAYMENT_RECEIVER: Stellar address that receives agent payments
# Leave blank for dev mode (no payments required)
HORIZON_PAYMENT_RECEIVER=
# Per-query price in XLM (default: 0.01)
HORIZON_PAYMENT_AMOUNT=0.01
# URL of the local Horizon x402 server
HORIZON_X402_SERVER_URL=http://localhost:3001

# Orchestrator admin key (for Shield Contract + Identity Registry calls)
ORCHESTRATOR_SECRET_KEY=

# Cross-agent awareness: Ledger inspects this wallet address on-chain
# (Set automatically by the orchestrator to the Scout agent's public key)
SCOUT_WALLET_ADDRESS=

# Dashboard
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
