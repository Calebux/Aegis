{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node10",
    "ignoreDeprecations": "5.0",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@calagent/shared": ["../shared/src/index.ts"],
      "@calebux/agent-kit": ["../agent-kit/src/index.ts"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../shared" },
    { "path": "../agent-kit" }
  ]
}
